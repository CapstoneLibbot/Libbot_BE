# Kestrel listens on every network interface so the Raspberry Pi can call it.
ASPNETCORE_URLS=http://0.0.0.0:5205

# Backend -> Raspberry Pi TCP workflow server.
LiBot__Host=192.168.1.8
LiBot__Port=9000
LiBot__ConnectTimeoutSeconds=5
LiBot__ResponseTimeoutSeconds=120

# Workflow TCP clients use runtime-specific endpoints.
LiBot__RuntimeEndpoints__sim__Host=127.0.0.1
LiBot__RuntimeEndpoints__sim__Port=9001
LiBot__RuntimeEndpoints__real__Host=192.168.1.8
LiBot__RuntimeEndpoints__real__Port=9000

# Raspberry Pi -> Backend callback URL.
LiBot__BackendBaseUrl=http://192.168.1.10:5205

# Runtime registry used by the web operations screen.
RobotRuntimes__sim__Host=127.0.0.1
RobotRuntimes__sim__Port=9001
RobotRuntimes__sim__DisplayName=Gazebo SIM
RobotRuntimes__sim__Kind=SIM
RobotRuntimes__real__Host=192.168.1.8
RobotRuntimes__real__Port=9000
RobotRuntimes__real__DisplayName=LiBot Real
RobotRuntimes__real__Kind=REAL

# SQL Server database used by the BE.
ConnectionStrings__LiBot=Server=localhost;Database=LiBotDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
